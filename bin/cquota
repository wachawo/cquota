#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Launcher that runs the ledger straight from a checkout, without installing it."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

# Local imports
from cquota import cli


def main():
    cli.main()


if __name__ == "__main__":
    main()
